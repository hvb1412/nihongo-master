# Default for local PostgreSQL. For Neon, replace DATABASE_URL with the pooled URL.
DATABASE_URL=postgresql://nihongo:nihongo_dev@127.0.0.1:55432/nihongo
# For Neon migrations, uncomment and use the direct URL from the same branch.
# DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
PORT=4000
APP_ORIGIN=http://127.0.0.1:4175
# Optional HTTPS origin to serve imported audio/stroke resources
MEDIA_BASE_URL=
SERVE_FRONTEND=0
# Use 1 only when behind a trusted single HTTP proxy
TRUST_PROXY=0

