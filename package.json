{
  "name": "nihongo-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "workspaces": ["fe", "be"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w be\" \"npm run dev -w fe\"",
    "dev:db": "node be/scripts/local-db.mjs",
    "db:generate": "npm run db:generate -w be",
    "db:migrate": "npm run db:migrate -w be",
    "db:seed": "npm run db:seed -w be",
    "db:import": "npm run db:import -w be",
    "build": "npm run build -w fe",
    "typecheck": "npm run typecheck -w fe",
    "lint": "eslint .",
    "test": "npm test -w be && npm test -w fe",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.0"
  }
}
